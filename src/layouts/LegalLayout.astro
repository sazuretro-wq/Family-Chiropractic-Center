---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<BaseLayout title={`${title} | Family Chiropractic Center`}>
  <SiteHeader />
  <main>
    <section class="bg-ink-900 pt-[182px] pb-16 md:pt-40">
      <div class="container-site flex flex-col items-center gap-6 text-center">
        <Eyebrow tone="dark">Legal</Eyebrow>
        <h1 class="type-h1 text-white">{title}</h1>
      </div>
    </section>
    <section class="section bg-white">
      <div class="container-site">
        <div class="mx-auto flex max-w-[794px] flex-col gap-4 font-body text-base leading-[1.7] text-gray-600 [&_h2]:mt-6 [&_h2]:font-heading [&_h2]:text-xl [&_h2]:font-medium [&_h2]:text-ink-900">
          <slot />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
