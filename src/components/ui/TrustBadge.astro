---
/** <TrustBadge> — gold icon tile + title + subtitle (Trust Bar). */
interface Props {
  icon: string;
  title: string;
  subtitle: string;
  class?: string;
}
const { icon, title, subtitle, class: className } = Astro.props;
---

<div class:list={['flex items-center gap-2.5 md:gap-4', className]}>
  <span class="flex shrink-0 items-center rounded-[6.4px] bg-linear-to-b from-gold-300 to-[#e7daab] p-[6.4px] md:rounded-lg md:p-2">
    <img src={icon} alt="" width="24" height="24" class="size-[19.2px] md:size-6" />
  </span>
  <span class="flex min-w-0 flex-col gap-1">
    <span class="font-heading text-[10px] leading-[1.1] md:text-[15px] font-bold text-ink-900">{title}</span>
    <span class="font-body text-[9px] leading-none md:text-xs tracking-[0.48px] text-gray-600 uppercase">{subtitle}</span>
  </span>
</div>
