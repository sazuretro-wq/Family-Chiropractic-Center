---
/**
 * <PhoneButton> — Figma: Button / Outline Light (Phone)
 * tel: pill used in the header & CTA.
 * tone: light (white text, over dark hero) | dark (black text, on cream)
 * compact: shows "Call Now" (mobile header)
 */
import { site } from '@/data/site';

interface Props {
  tone?: 'light' | 'dark';
  compact?: boolean;
  class?: string;
}
const { tone = 'light', compact = false, class: className } = Astro.props;
---

<a
  href={site.phoneHref}
  class:list={[
    'btn',
    tone === 'light' ? 'btn-outline-light' : 'btn-outline-dark',
    compact ? 'h-[30px] px-4 text-xs tracking-[0.48px]' : 'px-6',
    className,
  ]}
  aria-label={`Call ${site.name} at ${site.phone}`}
>
  {compact ? 'Call Now' : <>Call {site.phone}</>}
</a>
