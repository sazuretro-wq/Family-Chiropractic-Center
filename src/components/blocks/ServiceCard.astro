---
/** <ServiceCard> — white card on cream section: icon, title, description. */
interface Props {
  icon: string;
  title: string;
  description: string;
  class?: string;
}
const { icon, title, description, class: className } = Astro.props;
---

<article class:list={['flex flex-col gap-10 rounded-2xl bg-white p-6 lg:gap-16', className]}>
  <img src={icon} alt="" width="44" height="44" class="size-11" />
  <div class="flex flex-col gap-2">
    <h3 class="type-h4 text-ink-900">{title}</h3>
    <p class="font-body text-base leading-[1.4] text-gray-600/80">{description}</p>
  </div>
</article>
