---
/**
 * <LeadForm> — $59 New Patient Special booking form.
 * POSTs JSON to /api/lead (Cloudflare Worker, worker/lead.ts) then redirects to /thank-you.
 * Works without JS too: native POST → function answers with a 303 redirect.
 */
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';

interface Props {
  id?: string;
  class?: string;
}
const { id = 'book', class: className } = Astro.props;
---

<form
  id={id}
  action="/api/lead"
  method="post"
  novalidate
  data-lead-form
  class:list={['relative flex w-full scroll-mt-24 flex-col items-center gap-6 rounded-2xl bg-cream-100 px-6 pt-10 pb-6', className]}
>
  <span class="badge-gold absolute -top-[15px] left-6">Limited spots this month</span>

  <div class="flex w-full flex-col gap-3 font-heading font-medium">
    <h2 class="text-2xl leading-[1.2] text-ink-900">Book your $59 New Patient Special</h2>
    <p class="text-sm leading-[1.2] text-gray-600">A quick form. We'll text or call to confirm.</p>
  </div>

  <span class="divider-dotted -mx-6 w-auto self-stretch" aria-hidden="true"></span>

  <div class="flex w-full flex-col gap-4">
    <label class="flex flex-col gap-2">
      <span class="field-label">Full name *</span>
      <input class="field-input" type="text" name="fullName" autocomplete="name" placeholder="eg. John Doe" required minlength="2" />
    </label>
    <label class="flex flex-col gap-2">
      <span class="field-label">Phone number *</span>
      <input
        class="field-input"
        type="tel"
        name="phone"
        autocomplete="tel"
        inputmode="tel"
        placeholder="eg. (651) 463‑2225"
        required
        pattern="[0-9()+\-.\s]{10,}"
      />
    </label>
    <label class="flex flex-col gap-2">
      <span class="field-label">Email *</span>
      <input class="field-input" type="email" name="email" autocomplete="email" placeholder="eg. john@example.com" required />
    </label>
    <!-- honeypot -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  </div>

  <label class="flex w-full cursor-pointer items-start gap-2">
    <input
      type="checkbox"
      name="smsConsent"
      value="yes"
      class="mt-px size-4 shrink-0 cursor-pointer appearance-none rounded border border-black/12 bg-white bg-center bg-no-repeat checked:border-gold-700 checked:bg-gold-700 checked:bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2016%2016%22%3E%3Cpath%20d=%22M4%208.5l2.5%202.5L12%205.5%22%20fill=%22none%22%20stroke=%22white%22%20stroke-width=%222%22%20stroke-linecap=%22round%22%20stroke-linejoin=%22round%22/%3E%3C/svg%3E')]"
    />
    <span class="flex-1 font-body text-[10px] leading-[1.3] text-[#3d3d3d]">
      By checking this box, you consent to receive text messages from Family Chiropractic Center at the number
      provided, including appointment reminders and follow‑ups. Msg frequency varies. Msg &amp; data rates may apply.
      Reply STOP to unsubscribe. Reply HELP for help.
      <a href={site.privacyHref} class="underline">Privacy Policy</a> | <a href={site.termsHref} class="underline">Terms</a>.
    </span>
  </label>

  <p data-form-error class="hidden w-full rounded-lg bg-error/10 px-3 py-2 font-body text-xs text-error" role="alert"></p>

  <Button variant="dark" type="submit" fullWidth data-submit>Book My Appointment</Button>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-lead-form]');

  forms.forEach((form) => {
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.textContent;

    const showError = (msg: string) => {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) el.removeAttribute('aria-invalid');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');

      const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
      const invalid = fields.filter((f) => !f.checkValidity());
      fields.forEach((f) => (f.checkValidity() ? f.removeAttribute('aria-invalid') : f.setAttribute('aria-invalid', 'true')));
      if (invalid.length) {
        invalid[0].focus();
        showError('Please fill in your name, a valid phone number and email.');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending…';

      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        // `astro dev` has no Pages Functions (404) — continue to the thank-you page so the flow can be tested locally.
        if (res.ok || (import.meta.env.DEV && res.status === 404)) {
          window.location.href = '/thank-you';
          return;
        }
        const body = await res.json().catch(() => ({}));
        throw new Error(body.error || 'Something went wrong.');
      } catch (err) {
        showError(`${(err as Error).message} Please try again or call us at (651) 463‑2225.`);
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  });
</script>
