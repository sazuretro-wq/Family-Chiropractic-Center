---
/** <IncludedCard> — cream card with round icon, index number, title, description. */
interface Props {
  icon: string;
  index: string;
  title: string;
  description: string;
  class?: string;
}
const { icon, index, title, description, class: className } = Astro.props;
---

<article class:list={['flex h-full flex-col gap-10 lg:min-h-[321px] rounded-2xl bg-cream-100 p-6 lg:gap-16', className]}>
  <div class="flex items-start justify-between">
    <span class="relative flex size-16 shrink-0 items-center justify-center rounded-full border border-gold-400 bg-white">
      <img src={icon} alt="" width="28" height="28" class="size-7" />
    </span>
    <span class="font-heading text-[13px] leading-none tracking-[1.3px] text-gray-400">{index}</span>
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="type-h4 text-ink-900">{title}</h3>
    <p class="font-body text-base leading-[1.4] text-gray-600/80">{description}</p>
  </div>
</article>
