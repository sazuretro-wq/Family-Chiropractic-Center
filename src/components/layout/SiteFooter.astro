---
/** <SiteFooter> — badge logo, address, legal links, SMS disclaimer. */
import { site } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/8 bg-ink-900 py-16">
  <div class="container-site flex flex-col items-center gap-6 text-center">
    <img src="/images/logo-badge.svg" alt="Family Chiropractic Center — Chiropractic · Massage · Laser · Acupuncture" width="97" height="98" class="h-[98px] w-[96.88px]" loading="lazy" />
    <div class="flex flex-col items-center gap-4">
      <p class="font-heading text-base leading-[1.6] text-white/70 md:leading-[1.2]">
        <span class="block md:inline">{site.address}</span><span class="hidden md:inline"> · </span><a href={site.phoneHref} class="block hover:text-white md:inline">{site.phone}</a>
      </p>
      <nav class="flex items-center gap-2 font-heading text-sm leading-[1.2] font-semibold text-gold-300" aria-label="Legal">
        <a href={site.privacyHref} class="hover:underline">Privacy Policy</a>
        <span class="size-1 rounded-full bg-white" aria-hidden="true"></span>
        <a href={site.termsHref} class="hover:underline">Terms &amp; Conditions</a>
      </nav>
    </div>
    <hr class="w-full border-white/10" />
    <p class="max-w-[602px] font-body text-xs leading-[1.6] text-white/45">
      Message and data rates may apply. Message frequency varies. Reply STOP to unsubscribe. Reply HELP for help.<br />
      © {year} Family Chiropractic Center. All rights reserved.
    </p>
  </div>
</footer>
