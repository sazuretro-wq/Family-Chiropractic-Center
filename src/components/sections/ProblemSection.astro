---
/** <ProblemSection> — SectionHeading + rich text · narrow container 794. */
import SectionHeading from '@/components/blocks/SectionHeading.astro';
---

<section class="section bg-gold-50">
  <div class="container-site">
    <div class="mx-auto flex max-w-[794px] flex-col items-center gap-8 text-center">
      <SectionHeading eyebrow="A Different Approach">
        Living with pain <br class="hidden sm:block" />shouldn't be <em>your normal.</em>
      </SectionHeading>
      <div class="type-body-lg flex flex-col gap-4 text-gray-800">
        <p>
          If you're dealing with back pain, neck stiffness, headaches, or sciatica, you know how it takes over
          everything. your sleep, your energy, your ability to enjoy the things you love.
        </p>
        <p>
          Maybe you've tried medications that only mask the symptoms. Maybe you've been told surgery is your only
          option. Maybe you've just been pushing through and hoping it goes away.
        </p>
        <p>
          <strong class="font-bold text-ink-900">At Family Chiropractic Center, we take a different approach.</strong>
          Instead of covering up the pain, we find the root cause using advanced neurological scanning technology and
          build a plan to actually fix it.
        </p>
      </div>
      <p class="font-heading text-sm leading-none tracking-[1.82px] text-gold-700 uppercase">— The FCC Team</p>
    </div>
  </div>
</section>
