---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import ProblemSection from '@/components/sections/ProblemSection.astro';
import IncludedSection from '@/components/sections/IncludedSection.astro';
import DoctorsSection from '@/components/sections/DoctorsSection.astro';
import PhotoStrip from '@/components/sections/PhotoStrip.astro';
import ReviewsSection from '@/components/sections/ReviewsSection.astro';
import StepsSection from '@/components/sections/StepsSection.astro';
import ServicesSection from '@/components/sections/ServicesSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
---

<BaseLayout>
  <SiteHeader />
  <main>
    <HeroSection />
    <TrustBar />
    <ProblemSection />
    <IncludedSection />
    <DoctorsSection />
    <PhotoStrip variant="staff" />
    <ReviewsSection />
    <StepsSection />
    <ServicesSection />
    <FaqSection />
    <CtaSection />
    <PhotoStrip variant="team" />
  </main>
  <SiteFooter />
</BaseLayout>
